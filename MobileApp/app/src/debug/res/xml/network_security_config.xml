<?xml version="1.0" encoding="utf-8"?>
<!--
    Autorise les requêtes HTTP en clair vers des serveurs locaux (dev/test).
    Ne doit être utilisé qu'en build debug.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>    <!-- émulateur Android → localhost -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
