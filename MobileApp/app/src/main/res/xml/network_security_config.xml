<?xml version="1.0" encoding="utf-8"?>
<!--
    Autorise les requêtes HTTP en clair vers des serveurs locaux (dev/test).
    ⚠️ Fichier à utiliser uniquement en debug/local : en production, utiliser uniquement HTTPS
    et une configuration réseau dédiée à la release.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>    <!-- émulateur Android → localhost -->
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
