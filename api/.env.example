# Variables d'environnement pour l'API Node.js
# IMPORTANT: Ne jamais versionner ce fichier sur GitHub (ajouté dans .gitignore)

# Connexion MongoDB Atlas ou locale
MONGO_URI=mongodb://localhost:27017/sae_bornes

# Clé secrète pour signer les tokens JWT (changer en production !)
JWT_SECRET=changez_moi_en_production

# Durée de validité d'un token JWT (ex: 1h, 7d)
JWT_EXPIRE=8h

# Port d'écoute du serveur Express
PORT=3000
